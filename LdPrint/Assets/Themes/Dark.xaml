<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- LDF Dark Steel — neutral charcoal (NOT blueish Fluent) inspired by the
       Lucky Dragon Flow web portal: macOS-dark uголь surfaces with rose-gold
       accent matching the Lucky Dragon logo. -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="#1C1C1E"/>
  <SolidColorBrush x:Key="SurfaceBrush"    Color="#242424"/>
  <SolidColorBrush x:Key="ElevatedBrush"   Color="#2C2C2E"/>
  <SolidColorBrush x:Key="BorderBrush"     Color="#3D3A36"/>

  <!-- Text — silver from the logo, not pure white -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0EDE8"/>
  <SolidColorBrush x:Key="TextMutedBrush"   Color="#9E9A94"/>

  <!-- Accent: rose gold from the Lucky Dragon logo. Same hue across both
       themes — a single brand-identity stroke. -->
  <SolidColorBrush x:Key="AccentBrush"           Color="#C49A7A"/>
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1C1C1E"/>

  <!-- Semantic -->
  <SolidColorBrush x:Key="DangerBrush" Color="#C0504A"/>

  <!-- Preview backdrop — slightly darker than the window so the white paper
       reads as a distinct object on a desk. -->
  <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#161616"/>

  <!-- Backwards-compat aliases -->
  <SolidColorBrush x:Key="MutedBrush" Color="#9E9A94"/>
</ResourceDictionary>
