<Window x:Class="LdPrint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LdPrint.Models"
        xmlns:loc="clr-namespace:LdPrint.Services"
        Title="{loc:T window_title}"
        Icon="/Assets/AppIcon.ico"
        Width="1020" Height="660"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Golos Text, Segoe UI" FontSize="13"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- toolbar -->
      <RowDefinition Height="Auto"/>  <!-- printer + pages -->
      <RowDefinition Height="*"/>     <!-- list + preview -->
      <RowDefinition Height="Auto"/>  <!-- status + buttons -->
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="{loc:T open_file}"
                Command="{Binding OpenFileCommand}"
                Padding="14,6" MinWidth="140"/>

        <TextBlock Grid.Column="1" Text="{Binding FileLabel}"
                   VerticalAlignment="Center" Margin="14,0"
                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>

        <TextBlock Grid.Column="2" Text="{loc:T theme_label}"
                   VerticalAlignment="Center" Margin="0,0,6,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <ComboBox Grid.Column="3" MinWidth="160"
                  ItemsSource="{Binding AvailableThemes}"
                  SelectedItem="{Binding SelectedTheme}"
                  DisplayMemberPath="DisplayName"
                  Padding="6,4"
                  Margin="0,0,12,0"/>

        <TextBlock Grid.Column="4" Text="{loc:T language_label}"
                   VerticalAlignment="Center" Margin="0,0,6,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <ComboBox Grid.Column="5" MinWidth="120"
                  ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberPath="DisplayName"
                  Padding="6,4"/>

        <Button Grid.Column="6" Content="{loc:T refresh_printers}"
                Command="{Binding RefreshPrintersCommand}"
                Padding="12,6" MinWidth="160" Margin="8,0,0,0"/>
      </Grid>
    </Border>

    <!-- Printer + page range -->
    <Grid Grid.Row="1" Margin="12,12,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T printer_label}"
                 VerticalAlignment="Center"/>
      <ComboBox Grid.Row="0" Grid.Column="1"
                ItemsSource="{Binding Printers}"
                SelectedItem="{Binding SelectedPrinter}"
                Padding="6,4" Margin="0,2"
                ToolTip="{loc:T tooltip_printer}"/>
      <!-- Printer preferences (rundll32 printui.dll /e) — opens the standard
           Windows printing-preferences dialog for the selected device. -->
      <Button Grid.Row="0" Grid.Column="2"
              Content="{loc:T printer_settings}"
              Command="{Binding OpenPrinterSettingsCommand}"
              ToolTip="{loc:T tooltip_printer_settings}"
              Padding="10,4" Margin="8,2,0,2"
              MinWidth="40"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T pages_label}"
                 VerticalAlignment="Center" Margin="0,8,0,0"/>
      <!-- Pages textbox + placeholder hint overlay. The TextBlock sits on
           top of the empty textbox and disappears once the user types
           anything (DataTrigger on Text=""). -->
      <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
        <TextBox x:Name="PagesTextBox"
                 Text="{Binding PageRangeText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6,4"
                 Background="{DynamicResource ElevatedBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 ToolTip="{loc:T tooltip_pages}"/>
        <TextBlock Text="{loc:T pages_placeholder}"
                   IsHitTestVisible="False"
                   VerticalAlignment="Center"
                   Margin="10,0,10,0"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontStyle="Italic"
                   TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <!-- Show the hint only when the field is empty AND not focused.
                     When the user clicks in to type, the placeholder disappears
                     so it doesn't visually fight with the caret. -->
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Text, ElementName=PagesTextBox}" Value=""/>
                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PagesTextBox}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,8,0,0">
        <Button Content="{loc:T all_pages}" Command="{Binding SelectAllPagesCommand}"
                Padding="12,4" MinWidth="60"/>
        <Button Content="{loc:T current_page}" Command="{Binding SelectCurrentPageCommand}"
                Padding="12,4" MinWidth="80" Margin="6,0,0,0"/>
      </StackPanel>
    </Grid>

    <!-- List + Preview -->
    <Grid Grid.Row="2" Margin="12,4,12,12"
          PreviewMouseWheel="OnPreviewWheel">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              Background="{DynamicResource ElevatedBrush}">
        <ListBox ItemsSource="{Binding VisiblePages}"
                 SelectedItem="{Binding SelectedPage}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type models:TsplPage}">
              <StackPanel Margin="4">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{loc:T page_label}" FontWeight="SemiBold"/>
                  <TextBlock Text=" " FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Index, Converter={x:Static loc:OneBasedConverter.Instance}}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <!-- Muted by default; flip to AccentForeground when the parent
                       ListBoxItem is selected so the byte count keeps contrast
                       against the bright accent highlight. -->
                  <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontSize" Value="11"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Resources>
                  <TextBlock Text="{Binding SizeBytes}"/>
                  <TextBlock Text=" "/>
                  <TextBlock Text="{loc:T bytes_suffix}"/>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid Grid.Column="1" Margin="8,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- page indicator + metadata strip -->
          <RowDefinition Height="*"/>     <!-- preview -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                Padding="12,8">
          <StackPanel>
            <TextBlock Text="{Binding PageIndicator}"
                       FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding LabelMetadataText}"
                       FontSize="11" Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>
        </Border>

      <Border Grid.Row="1"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              Background="{DynamicResource PreviewBackgroundBrush}">
        <Grid>
          <!-- Image preview (shown when renderer has produced a bitmap).
               The label canvas is rendered white (paper); the surrounding
               area is PreviewBackgroundBrush (theme-aware desk colour) so
               the user sees the label as a distinct paper-on-desk object.
               A thin border + drop shadow further emphasise the boundary. -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="24"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Background="White"
                  SnapsToDevicePixels="True">
            <Border.Effect>
              <DropShadowEffect Color="Black" Opacity="0.35"
                                BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <Image Source="{Binding SelectedPage.PreviewImage}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"/>
          </Border>
          <!-- Text preview fallback: visible while the bitmap is being
               rendered or when rendering failed entirely. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPage.PreviewImage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <TextBlock Text="{Binding SelectedPage.PreviewText, FallbackValue=''}"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="12"
                       Foreground="#1F1F1F"
                       TextWrapping="NoWrap"
                       Padding="12"/>
          </ScrollViewer>
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- Status + buttons -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="12,10">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="{Binding AssociationButtonText}"
                  Command="{Binding ToggleFileAssociationCommand}"
                  Padding="14,8" MinWidth="220"/>
          <Button Content="{loc:T print}"
                  Command="{Binding PrintCommand}"
                  Padding="22,8" MinWidth="140" Margin="8,0,0,0"
                  FontWeight="SemiBold"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource AccentForegroundBrush}"
                  BorderThickness="0"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextMutedBrush}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
